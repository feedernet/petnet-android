<layout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools">
	<data>
		<variable name="viewModel"
			type="com.github.kruton.apps.myfeederconfig.list.FeederListViewModel" />
	</data>
	<LinearLayout android:layout_width="match_parent"
		android:layout_height="match_parent" android:orientation="vertical"
		android:paddingStart="20dp" android:paddingEnd="20dp"
		android:background="@color/canvas">
		<TextView android:layout_width="match_parent"
			android:layout_height="wrap_content" android:layout_marginTop="28dp"
			android:text="@string/discovery_eyebrow"
			android:textColor="@color/coral" android:textStyle="bold"
			android:textSize="12sp" android:letterSpacing="0.1" />
		<TextView android:layout_width="match_parent"
			android:layout_height="wrap_content" android:layout_marginTop="8dp"
			android:text="@string/discovery_title" android:textColor="@color/ink"
			android:textStyle="bold" android:textSize="30sp" />
		<TextView style="@style/BodyText"
			android:layout_width="match_parent"
			android:layout_height="wrap_content" android:layout_marginTop="8dp"
			android:text="@string/discovery_intro" />
		<TextView style="@style/SectionTitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content" android:layout_marginTop="28dp"
			android:text="@string/nearby_feeders" />
		<TextView android:id="@+id/scanStatus"
			style="@style/BodyText" android:layout_width="match_parent"
			android:layout_height="wrap_content" android:layout_marginTop="8dp"
			android:accessibilityLiveRegion="polite" />
		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/recyclerView" android:layout_width="match_parent"
			android:layout_height="0dp" android:layout_weight="1"
			android:clipToPadding="false" android:paddingBottom="20dp"
			tools:listitem="@layout/item_feeder" />
	</LinearLayout>
</layout>