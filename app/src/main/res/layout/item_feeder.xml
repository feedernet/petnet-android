<layout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools">
	<data>
		<variable name="feeder"
			type="com.github.kruton.apps.myfeederconfig.Feeder" />
		<variable name="viewModel"
			type="com.github.kruton.apps.myfeederconfig.list.FeederListViewModel" />
	</data>
	<LinearLayout android:layout_width="match_parent"
		android:layout_height="wrap_content" android:layout_marginTop="12dp"
		android:background="@drawable/surface_card"
		android:foreground="?attr/selectableItemBackground"
		android:clickable="true" android:focusable="true"
		android:gravity="center_vertical" android:minHeight="88dp"
		android:padding="16dp"
		android:onClick="@{v -> viewModel.handleClick(feeder)}">
		<ImageView android:layout_width="48dp"
			android:layout_height="48dp" android:src="@drawable/feeder_icon"
			android:contentDescription="@null" />
		<LinearLayout android:layout_width="0dp"
			android:layout_height="wrap_content" android:layout_weight="1"
			android:orientation="vertical" android:layout_marginStart="14dp">
			<TextView android:id="@+id/name"
				android:layout_width="match_parent"
				android:layout_height="wrap_content" android:text="@{feeder.name}"
				android:textColor="@color/ink" android:textSize="17sp"
				android:textStyle="bold" tools:text="SmartFeeder" />
			<TextView android:id="@+id/mac" style="@style/BodyText"
				android:layout_width="match_parent"
				android:layout_height="wrap_content" android:layout_marginTop="4dp"
				android:text="@{feeder.mac}" tools:text="12:34:56:78:9A:BC" />
		</LinearLayout>
		<TextView android:layout_width="wrap_content"
			android:layout_height="wrap_content" android:text="›"
			android:textColor="@color/coral" android:textSize="28sp"
			android:importantForAccessibility="no" />
	</LinearLayout>
</layout>