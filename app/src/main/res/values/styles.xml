<resources>
	<style name="AppTheme"
		parent="Theme.MaterialComponents.Light.NoActionBar">
		<item name="colorPrimary">@color/colorPrimary</item>
		<item name="colorPrimaryDark">@color/colorPrimaryDark</item>
		<item name="colorAccent">@color/colorAccent</item>
		<item name="android:fontFamily">sans</item>
		<item name="android:windowLightStatusBar">false</item>
		<item name="android:navigationBarColor">@color/colorPrimaryDark</item>
		<item name="android:windowBackground">@color/canvas</item>
	</style>
	<style name="AppTheme.NoActionBar" parent="AppTheme" />
	<style name="AppTheme.AppBarOverlay"
		parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
	<style name="AppTheme.PopupOverlay"
		parent="ThemeOverlay.AppCompat.Light" />
	<style name="SectionTitle">
		<item name="android:textColor">@color/ink</item>
		<item name="android:textSize">21sp</item>
		<item name="android:textStyle">bold</item>
		<item name="android:layout_marginBottom">8dp</item>
	</style>
	<style name="BodyText">
		<item name="android:textColor">@color/muted</item>
		<item name="android:textSize">14sp</item>
		<item name="android:lineSpacingExtra">3dp</item>
	</style>
	<style name="SetupField" parent="Widget.AppCompat.EditText">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:minHeight">56dp</item>
		<item name="android:textColor">@color/ink</item>
		<item name="android:textColorHint">@color/muted</item>
		<item name="android:layout_marginTop">8dp</item>
	</style>
	<style name="SetupButton"
		parent="Widget.MaterialComponents.Button">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:minHeight">48dp</item>
		<item name="android:layout_marginTop">8dp</item>
		<item name="android:textAllCaps">false</item>
		<item name="cornerRadius">12dp</item>
	</style>
	<style name="SecondaryButton"
		parent="Widget.MaterialComponents.Button.OutlinedButton">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:minHeight">48dp</item>
		<item name="android:layout_marginTop">8dp</item>
		<item name="android:textAllCaps">false</item>
		<item name="cornerRadius">12dp</item>
	</style>
</resources>